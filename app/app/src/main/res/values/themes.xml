<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LimePlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/bg_bar</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg_bar</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.LimePlayer.Player" parent="Theme.LimePlayer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 频道 Tab：实测爱奇艺约 30sp，选中加粗 -->
    <style name="Text.Tab" parent="">
        <item name="android:textSize">29sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 卡片标题：实测 24sp -->
    <style name="Text.CardTitle" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 卡片副标题：实测 20sp -->
    <style name="Text.CardSub" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 顶部导航：实测 30sp -->
    <style name="Text.Nav" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
