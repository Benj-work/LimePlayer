<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部品牌栏：120px 高，深藏蓝 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/topbar_height"
            android:background="@color/bg_bar"
            android:paddingStart="32dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_logo_mark" />

                <TextView
                    android:id="@+id/brand_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nav_search"
                    style="@style/Text.Nav"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/nav_pill_height"
                    android:background="@drawable/bg_nav_pill"
                    android:gravity="center"
                    android:paddingStart="@dimen/nav_pill_padding"
                    android:paddingEnd="@dimen/nav_pill_padding"
                    android:text="@string/nav_search" />

                <TextView
                    android:id="@+id/nav_history"
                    style="@style/Text.Nav"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/nav_pill_height"
                    android:layout_marginStart="@dimen/nav_pill_gap"
                    android:background="@drawable/bg_nav_pill"
                    android:gravity="center"
                    android:paddingStart="@dimen/nav_pill_padding"
                    android:paddingEnd="@dimen/nav_pill_padding"
                    android:text="@string/nav_history" />

                <TextView
                    android:id="@+id/nav_fav"
                    style="@style/Text.Nav"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/nav_pill_height"
                    android:layout_marginStart="@dimen/nav_pill_gap"
                    android:background="@drawable/bg_nav_pill"
                    android:gravity="center"
                    android:paddingStart="@dimen/nav_pill_padding"
                    android:paddingEnd="@dimen/nav_pill_padding"
                    android:text="收藏" />

                <ImageView
                    android:id="@+id/nav_settings"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_settings"
                    android:padding="12dp"
                    android:src="@drawable/ic_gear" />
            </LinearLayout>

            <!-- 搜索条：从右侧滑入，覆盖整条顶栏 -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:background="@color/bg_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/search_back"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:padding="12dp"
                    android:src="@drawable/ic_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        android:tint="@color/text_tertiary" />

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="搜索片名"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@null"
                        android:textSize="24sp" />

                    <ImageView
                        android:id="@+id/search_clear"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="清空"
                        android:padding="16dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/search_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="取消"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 频道栏：128px 高，与顶栏同色 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/tabbar_height"
            android:background="@color/bg_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="37dp"
            android:paddingEnd="20dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/tab_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/nav_pill_height"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_nav_pill"
                android:drawableStart="@drawable/ic_list"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_secondary"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/filter"
                android:textColor="@color/text_secondary"
                android:textSize="24sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="28dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- 空态 -->
    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="80dp"
        android:paddingEnd="80dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.55"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/empty_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/empty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/empty_desc"
            android:textColor="@color/text_secondary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/empty_action"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/ripple_btn_brand"
            android:gravity="center"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="@string/rescan"
            android:textColor="#08120A"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
